---
import type { LocaleCode } from '../../config/site';
import { getUi } from '../../i18n';
import { buildCanonicalUrl, localizePath } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const homeUrl = buildCanonicalUrl(locale, '');
const privacyUrl = buildCanonicalUrl(locale, 'privacy');

const schemas: Array<Record<string, unknown>> = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: ui.privacy.meta.h1,
    description: ui.privacy.meta.description,
    url: privacyUrl,
    inLanguage: locale === 'zh-cn' ? 'zh-CN' : locale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: ui.nav.home,
        item: homeUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: ui.footer.privacyLink,
        item: privacyUrl,
      },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  slug="privacy"
  title={ui.privacy.meta.title}
  description={ui.privacy.meta.description}
  schemas={schemas}
>
  <article class="mx-auto max-w-3xl px-4 pt-8 pb-12 sm:px-6 sm:pt-10">
    <Breadcrumbs
      ariaLabel={ui.nav.breadcrumbAria}
      items={[
        { label: ui.nav.home, href: localizePath(locale, '') },
        { label: ui.footer.privacyLink },
      ]}
    />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-[#27374D] sm:text-4xl dark:text-[#DDE6ED]">
        {ui.privacy.meta.h1}
      </h1>
      <p class="mt-3 text-base leading-relaxed text-[#526D82] sm:text-lg dark:text-[#9DB2BF]">
        {ui.privacy.meta.subtitle}
      </p>
      <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-[#526D82] dark:text-[#9DB2BF]">
        {ui.privacy.lastUpdated}
      </p>
    </header>

    <div class="space-y-6 rounded-3xl border border-[#9DB2BF]/55 bg-white p-6 sm:p-10 dark:border-[#526D82]/55 dark:bg-[#1D2A3B]">
      {ui.privacy.sections.map((sec) => (
        <section class="space-y-2.5">
          <h2 class="text-xl font-bold text-[#27374D] dark:text-[#DDE6ED]">
            {sec.heading}
          </h2>
          <p class="text-sm sm:text-base leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
            {sec.body}
          </p>
        </section>
      ))}
    </div>
  </article>
</BaseLayout>
