---
import {
  CATEGORY_HUB_SLUGS,
  TOOL_MAP,
  type LocaleCode,
  type ToolSlug,
} from '../../config/site';
import { getToolContent, getToolsDictionary, getUi } from '../../i18n';
import { buildCanonicalUrl, localizePath } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import ToolIcon from '../common/ToolIcon.astro';

import VideoToMp3 from '../tools/VideoToMp3';
import WebmToMp4 from '../tools/WebmToMp4';
import VideoCompressor from '../tools/VideoCompressor';
import VideoTrimmer from '../tools/VideoTrimmer';
import AudioJoiner from '../tools/AudioJoiner';
import Mp3Cutter from '../tools/Mp3Cutter';
import WavToMp3 from '../tools/WavToMp3';
import M4aToMp3 from '../tools/M4aToMp3';
import ImageCompressor from '../tools/ImageCompressor';
import WebpToJpg from '../tools/WebpToJpg';
import HeicToJpg from '../tools/HeicToJpg';
import ImageResizer from '../tools/ImageResizer';

interface Props {
  locale: LocaleCode;
  toolSlug: ToolSlug;
}

const { locale, toolSlug } = Astro.props;
const ui = getUi(locale);
const toolsDict = getToolsDictionary(locale);
const registry = TOOL_MAP[toolSlug];
const content = getToolContent(locale, toolSlug);
const categoryHubSlug = CATEGORY_HUB_SLUGS[registry.category];
const categoryContent = ui.categories[registry.category];

const homeUrl = buildCanonicalUrl(locale, '');
const hubUrl = buildCanonicalUrl(locale, categoryHubSlug);
const toolUrl = buildCanonicalUrl(locale, toolSlug);

// Strict JSON-LD for Tool Pages: WebApplication + FAQPage + BreadcrumbList (NO AggregateRating / Review)
const schemas: Array<Record<string, unknown>> = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: content.name,
    url: toolUrl,
    description: content.meta.description,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any (Web Browser)',
    browserRequirements: 'Requires JavaScript and WebAssembly',
    inLanguage: locale === 'zh-cn' ? 'zh-CN' : locale,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: ui.nav.home,
        item: homeUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: categoryContent.name,
        item: hubUrl,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: content.name,
        item: toolUrl,
      },
    ],
  },
];

const relatedTools = registry.related.map((slug) => ({
  slug,
  icon: TOOL_MAP[slug].icon,
  content: toolsDict[slug],
}));
---

<BaseLayout
  locale={locale}
  slug={toolSlug}
  title={content.meta.title}
  description={content.meta.description}
  schemas={schemas}
>
  <!-- ABOVE THE FOLD (Full Viewport Stage): Only Breadcrumbs, Clean H1, 1-sentence subtitle, and Interactive Tool UI -->
  <section class="mx-auto flex min-h-[calc(100dvh-4rem)] max-w-4xl flex-col px-4 pt-5 pb-5 sm:px-6 sm:pt-6 sm:pb-6">
    <Breadcrumbs
      ariaLabel={ui.nav.breadcrumbAria}
      items={[
        { label: ui.nav.home, href: localizePath(locale, '') },
        { label: categoryContent.name, href: localizePath(locale, categoryHubSlug) },
        { label: content.name },
      ]}
    />

    <div class="flex flex-1 flex-col justify-center py-3 sm:py-6">
      <div class="mb-6 text-center sm:mb-8">
        <h1 class="text-3xl font-extrabold tracking-tight text-[#27374D] sm:text-4xl lg:text-[2.65rem] lg:leading-tight dark:text-[#DDE6ED]">
          {content.meta.h1}
        </h1>
        <p class="mx-auto mt-3 max-w-2xl text-base leading-relaxed text-[#526D82] sm:text-lg dark:text-[#9DB2BF]">
          {content.meta.subtitle}
        </p>
      </div>

      <!-- Elevated Interactive Focal Tool Card -->
      <div class="rounded-3xl border border-[#9DB2BF]/65 bg-white p-5 shadow-xl shadow-[#27374D]/8 sm:p-8 dark:border-[#526D82]/70 dark:bg-[#1D2A3B] dark:shadow-black/30">
        {toolSlug === 'video-to-mp3' && <VideoToMp3 client:idle labels={ui.toolUi} />}
        {toolSlug === 'webm-to-mp4' && <WebmToMp4 client:idle labels={ui.toolUi} />}
        {toolSlug === 'video-compressor' && <VideoCompressor client:idle labels={ui.toolUi} />}
        {toolSlug === 'video-trimmer' && <VideoTrimmer client:idle labels={ui.toolUi} />}
        {toolSlug === 'audio-joiner' && <AudioJoiner client:idle labels={ui.toolUi} />}
        {toolSlug === 'mp3-cutter' && <Mp3Cutter client:idle labels={ui.toolUi} />}
        {toolSlug === 'wav-to-mp3' && <WavToMp3 client:idle labels={ui.toolUi} />}
        {toolSlug === 'm4a-to-mp3' && <M4aToMp3 client:idle labels={ui.toolUi} />}
        {toolSlug === 'image-compressor' && <ImageCompressor client:idle labels={ui.toolUi} />}
        {toolSlug === 'webp-to-jpg' && <WebpToJpg client:idle labels={ui.toolUi} />}
        {toolSlug === 'heic-to-jpg' && <HeicToJpg client:idle labels={ui.toolUi} />}
        {toolSlug === 'image-resizer' && <ImageResizer client:idle labels={ui.toolUi} />}
      </div>
    </div>

    <!-- Subtle scroll cue to educational guide & FAQs below the fold -->
    <div class="flex justify-center pt-2">
      <a
        href="#tool-guide"
        aria-label={content.howToTitle}
        title={content.howToTitle}
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#9DB2BF]/50 bg-white/80 text-[#526D82] transition-all hover:translate-y-0.5 hover:border-[#27374D] hover:text-[#27374D] dark:border-[#526D82]/60 dark:bg-[#1D2A3B]/80 dark:text-[#9DB2BF] dark:hover:border-[#DDE6ED] dark:hover:text-[#DDE6ED]"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 9l6 6 6-6" />
        </svg>
      </a>
    </div>
  </section>

  <!-- BELOW THE FOLD: Educational, Human-First SEO Content (Visible only when scrolling) -->
  <div id="tool-guide" class="scroll-mt-16 border-t border-[#9DB2BF]/35 dark:border-[#526D82]/35">
    <div class="mx-auto max-w-4xl space-y-12 px-4 pt-14 pb-6 sm:px-6 sm:pt-16">
    <!-- 1. How to Use (3 numbered steps) -->
    <section class="rounded-3xl border border-[#9DB2BF]/50 bg-white p-6 sm:p-8 dark:border-[#526D82]/50 dark:bg-[#1D2A3B]">
      <h2 class="text-2xl font-bold text-[#27374D] dark:text-[#DDE6ED]">
        {content.howToTitle}
      </h2>
      <ol class="mt-5 grid gap-4 sm:grid-cols-3">
        {content.howToSteps.map((step, idx) => (
          <li class="rounded-2xl border border-[#9DB2BF]/40 bg-[#F7F9FB] p-5 dark:border-[#526D82]/40 dark:bg-[#121A26]">
            <span class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-xl bg-[#27374D] text-sm font-extrabold text-white dark:bg-[#DDE6ED] dark:text-[#27374D]">
              {idx + 1}
            </span>
            <p class="text-sm leading-relaxed text-[#27374D] dark:text-[#DDE6ED]">{step}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 2. Why Process Files Locally -->
    <section class="space-y-5">
      <h2 class="text-2xl font-bold text-[#27374D] dark:text-[#DDE6ED]">
        {content.whyLocalTitle}
      </h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {content.whyLocalPoints.map((pt) => (
          <div class="rounded-2xl border border-[#9DB2BF]/50 bg-white p-5 dark:border-[#526D82]/50 dark:bg-[#1D2A3B]">
            <h3 class="text-base font-bold text-[#27374D] dark:text-[#DDE6ED]">{pt.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">{pt.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. About Format / Topic -->
    <article class="rounded-3xl border border-[#9DB2BF]/50 bg-white p-6 sm:p-8 dark:border-[#526D82]/50 dark:bg-[#1D2A3B]">
      <h2 class="text-2xl font-bold text-[#27374D] dark:text-[#DDE6ED]">
        {content.aboutTitle}
      </h2>
      <div class="mt-4 space-y-4 text-base leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
        {content.aboutParagraphs.map((para) => (
          <p>{para}</p>
        ))}
      </div>
    </article>

    <!-- 4. Frequently Asked Questions (Matches FAQPage JSON-LD verbatim) -->
    <section class="space-y-5">
      <h2 class="text-2xl font-bold text-[#27374D] dark:text-[#DDE6ED]">
        {content.faqTitle}
      </h2>
      <div class="space-y-3">
        {content.faqs.map((faq) => (
          <article class="rounded-2xl border border-[#9DB2BF]/50 bg-white p-5 sm:p-6 dark:border-[#526D82]/50 dark:bg-[#1D2A3B]">
            <h3 class="text-base font-bold text-[#27374D] dark:text-[#DDE6ED]">
              {faq.question}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
              {faq.answer}
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- 5. Related Media Tools (3 contextual internal links) -->
    <section class="space-y-5">
      <h2 class="text-2xl font-bold text-[#27374D] dark:text-[#DDE6ED]">
        {content.relatedTitle}
      </h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {relatedTools.map((rel) => (
          <a
            href={localizePath(locale, rel.slug)}
            class="group flex flex-col justify-between rounded-2xl border border-[#9DB2BF]/55 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-[#27374D] hover:shadow-md dark:border-[#526D82]/60 dark:bg-[#1D2A3B] dark:hover:border-[#DDE6ED]"
          >
            <div class="space-y-2.5">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#DDE6ED] text-[#27374D] transition-colors group-hover:bg-[#27374D] group-hover:text-white dark:bg-[#27374D] dark:text-[#DDE6ED] dark:group-hover:bg-[#DDE6ED] dark:group-hover:text-[#27374D]">
                <ToolIcon icon={rel.icon} size={20} />
              </span>
              <h3 class="text-base font-bold text-[#27374D] dark:text-[#DDE6ED]">
                {rel.content.name}
              </h3>
              <p class="text-xs leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
                {rel.content.cardDesc}
              </p>
            </div>
            <span class="mt-4 inline-flex items-center gap-1 text-xs font-bold text-[#27374D] dark:text-[#DDE6ED]">
              {ui.home.openTool} <span aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>
    </section>
    </div>
  </div>
</BaseLayout>
