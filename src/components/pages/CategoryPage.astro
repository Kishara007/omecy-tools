---
import {
  CATEGORY_HUB_SLUGS,
  getToolsByCategory,
  type CategoryId,
  type LocaleCode,
} from '../../config/site';
import { getToolsDictionary, getUi } from '../../i18n';
import { buildCanonicalUrl, localizePath } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import ToolIcon from '../common/ToolIcon.astro';

interface Props {
  locale: LocaleCode;
  category: CategoryId;
}

const { locale, category } = Astro.props;
const ui = getUi(locale);
const toolsDict = getToolsDictionary(locale);
const hubSlug = CATEGORY_HUB_SLUGS[category];
const content = ui.categories[category];
const tools = getToolsByCategory(category);

const homeUrl = buildCanonicalUrl(locale, '');
const hubUrl = buildCanonicalUrl(locale, hubSlug);

const schemas: Array<Record<string, unknown>> = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: content.meta.h1,
    description: content.meta.description,
    url: hubUrl,
    inLanguage: locale === 'zh-cn' ? 'zh-CN' : locale,
    hasPart: tools.map((t) => ({
      '@type': 'WebApplication',
      name: toolsDict[t.slug].name,
      url: buildCanonicalUrl(locale, t.slug),
      applicationCategory: 'MultimediaApplication',
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: ui.nav.home,
        item: homeUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: content.name,
        item: hubUrl,
      },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  slug={hubSlug}
  title={content.meta.title}
  description={content.meta.description}
  schemas={schemas}
>
  <section class="mx-auto max-w-5xl px-4 pt-8 pb-12 sm:px-6 sm:pt-10">
    <Breadcrumbs
      ariaLabel={ui.nav.breadcrumbAria}
      items={[
        { label: ui.nav.home, href: localizePath(locale, '') },
        { label: content.name },
      ]}
    />

    <div class="mb-10 max-w-3xl">
      <span class="inline-block rounded-full bg-[#DDE6ED] px-3.5 py-1 text-xs font-bold text-[#27374D] dark:bg-[#27374D] dark:text-[#DDE6ED]">
        {content.badge}
      </span>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-[#27374D] sm:text-4xl dark:text-[#DDE6ED]">
        {content.meta.h1}
      </h1>
      <p class="mt-3 text-base leading-relaxed text-[#526D82] sm:text-lg dark:text-[#9DB2BF]">
        {content.meta.subtitle}
      </p>
    </div>

    <!-- 4 Category Tool Cards -->
    <div class="grid gap-5 sm:grid-cols-2">
      {tools.map((tool) => {
        const tContent = toolsDict[tool.slug];
        return (
          <a
            href={localizePath(locale, tool.slug)}
            class="group flex flex-col justify-between rounded-2xl border border-[#9DB2BF]/60 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-[#27374D] hover:shadow-md dark:border-[#526D82]/60 dark:bg-[#1D2A3B] dark:hover:border-[#DDE6ED]"
          >
            <div class="space-y-3">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[#DDE6ED] text-[#27374D] transition-colors group-hover:bg-[#27374D] group-hover:text-white dark:bg-[#27374D] dark:text-[#DDE6ED] dark:group-hover:bg-[#DDE6ED] dark:group-hover:text-[#27374D]">
                <ToolIcon icon={tool.icon} size={24} />
              </span>
              <h2 class="text-xl font-bold text-[#27374D] dark:text-[#DDE6ED]">
                {tContent.name}
              </h2>
              <p class="text-sm leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
                {tContent.cardDesc}
              </p>
            </div>
            <div class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-[#27374D] dark:text-[#DDE6ED]">
              <span>{ui.home.openTool}</span>
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Educational Context -->
    <article class="mt-14 space-y-8 rounded-3xl border border-[#9DB2BF]/50 bg-white p-7 sm:p-10 dark:border-[#526D82]/50 dark:bg-[#1D2A3B]">
      <div class="space-y-3">
        <h2 class="text-2xl font-bold text-[#27374D] dark:text-[#DDE6ED]">
          {content.introHeading}
        </h2>
        <p class="text-base leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">
          {content.introBody}
        </p>
      </div>

      <div class="space-y-4">
        <h2 class="text-xl font-bold text-[#27374D] dark:text-[#DDE6ED]">
          {content.benefitsHeading}
        </h2>
        <div class="grid gap-4 sm:grid-cols-3">
          {content.benefits.map((b) => (
            <div class="rounded-2xl border border-[#9DB2BF]/40 bg-[#F7F9FB] p-5 dark:border-[#526D82]/40 dark:bg-[#121A26]">
              <h3 class="text-base font-bold text-[#27374D] dark:text-[#DDE6ED]">{b.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[#526D82] dark:text-[#9DB2BF]">{b.body}</p>
            </div>
          ))}
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
