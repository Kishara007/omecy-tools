---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  ariaLabel: string;
  items: BreadcrumbItem[];
}

const { ariaLabel, items } = Astro.props;
---

<nav aria-label={ariaLabel} class="mb-4 text-xs sm:text-sm text-[#526D82] dark:text-[#9DB2BF]">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((item, idx) => {
      const isLast = idx === items.length - 1;
      return (
        <li class="inline-flex items-center gap-1.5">
          {idx > 0 && (
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              class="opacity-60"
            >
              <path d="M9 18l6-6-6-6" />
            </svg>
          )}
          {item.href && !isLast ? (
            <a
              href={item.href}
              class="font-medium transition-colors hover:text-[#27374D] hover:underline dark:hover:text-[#DDE6ED]"
            >
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="font-semibold text-[#27374D] dark:text-[#DDE6ED]">
              {item.label}
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>
